# Senha do painel web (usuario pode ser qualquer coisa)
PAINEL_SENHA=troque-esta-senha
PAINEL_PORTA=8080

# Nome exato do grupo, como aparece no WhatsApp
GRUPO_NOME=Minha Loja | Grupo 1

# Telefones dos admins (com 55), separados por virgula. Post desses numeros abre/atualiza rateio.
ADMINS=5519999999999,5519888888888

# Telefone que recebe a lista no modo sombra e as mensagens que o robo nao entendeu
AVISAR_ADMIN=5519999999999

LOG_LEVEL=INFO

# IA de apoio (opcional): so pras mensagens que a regra nao entendeu. Sem chave, fica desligada.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5
